{
  "name": "photon-msg",
  "version": "0.1.0",
  "description": "Command-line client for sending and reading messages through the Photon API",
  "type": "module",
  "license": "MIT",
  "bin": {
    "photon-msg": "dist/bin.js",
    "pmsg": "dist/bin.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \".test-build/test/*.test.js\"",
    "test:watch": "npm run build:test && node --test --watch \".test-build/test/*.test.js\"",
    "clean": "rm -rf dist .test-build",
    "prepublishOnly": "npm run clean && npm run build",
    "smoke": "npm run build && node dist/bin.js --help"
  },
  "keywords": [
    "photon",
    "imessage",
    "sms",
    "messaging",
    "cli"
  ],
  "dependencies": {
    "@photon-ai/api": "^0.6.0"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
