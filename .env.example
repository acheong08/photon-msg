# Project API key with project:read, project:write (and platforms:read/write for line commands)
PHOTON_API_KEY=pho_sk_replace_me

# Project the key belongs to
PHOTON_PROJECT_ID=pho_prj_replace_me

# Optional: default sender for --as (handle or pho_usr_ id)
# PHOTON_AGENT_HANDLE=+16285024649

# Optional: override the API origin (staging, local mocks)
# PHOTON_API_BASE_URL=https://api.photon.codes
